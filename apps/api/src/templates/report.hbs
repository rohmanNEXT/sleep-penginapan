<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Laporan Masalah Baru</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background-color: #f5f0e8;
      color: #1a1a1a;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background-color: #ffffff;
      border: 3px solid #1a1a1a;
      border-radius: 16px;
      box-shadow: 6px 6px 0px 0px #1a1a1a;
      overflow: hidden;
    }
    .header {
      background-color: #ffcc00;
      border-bottom: 3px solid #1a1a1a;
      padding: 20px;
      text-align: center;
      font-weight: 900;
      text-transform: uppercase;
      font-size: 24px;
      letter-spacing: 1px;
    }
    .content {
      padding: 30px;
    }
    .field {
      margin-bottom: 20px;
    }
    .field-label {
      font-size: 10px;
      font-weight: 900;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 5px;
    }
    .field-value {
      font-size: 16px;
      font-weight: bold;
      color: #1a1a1a;
      background-color: #f5f0e8;
      padding: 12px 16px;
      border: 2px solid #1a1a1a;
      border-radius: 8px;
    }
    .message-box {
      font-size: 14px;
      line-height: 1.6;
      font-weight: 600;
      color: #1a1a1a;
      background-color: #f5f0e8;
      padding: 16px;
      border: 2px solid #1a1a1a;
      border-radius: 8px;
      white-space: pre-wrap;
    }
    .footer {
      background-color: #1a1a1a;
      color: #ffffff;
      padding: 15px;
      text-align: center;
      font-size: 12px;
      font-weight: bold;
      text-transform: uppercase;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      Laporan Masalah Baru
    </div>
    <div class="content">
      <div class="field">
        <div class="field-label">Nama Pengirim</div>
        <div class="field-value">{{name}}</div>
      </div>
      <div class="field">
        <div class="field-label">Alamat Email</div>
        <div class="field-value">{{email}}</div>
      </div>
      <div class="field">
        <div class="field-label">Subjek Laporan</div>
        <div class="field-value">{{subject}}</div>
      </div>
      <div class="field">
        <div class="field-label">Detail Pesan</div>
        <div class="message-box">{{message}}</div>
      </div>
    </div>
    <div class="footer">
      Penginapan App Report System
    </div>
  </div>
</body>
</html>
