{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "serve": "turbo run serve",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "postprepare": "bash -c 'chmod ug+x .husky/*'",
    "db:init": "cd apps/api && npx prisma migrate dev --name init && npx prisma generate",
    "db:local": "cd apps/api && npx prisma migrate dev --name update && npx prisma generate",
    "db:deploy": "cd apps/api && npx prisma migrate deploy && npx prisma generate"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.2",
    "@commitlint/config-conventional": "^18.4.2",
    "@types/node": "^25.9.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.48.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.1.0",
    "postcss": "^8.5.15",
    "prettier": "^3.1.0",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig": "*",
    "turbo": "latest",
    "typescript": "^6.0.3"
  },
  "name": "finpro-nextjs-express-prisma",
  "packageManager": "npm@8.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^5.22.0",
    "@prisma/engines": "^5.14.0",
    "@types/axios": "^0.14.0",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "formik": "^2.4.9",
    "iproute": "^2.3.0",
    "lucide-react": "^1.16.0",
    "mime-db": "^1.54.0",
    "next": "^16.2.7",
    "prisma": "^5.22.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yup": "^1.7.1"
  }
}
